<?xml version='1.0'?>
<!-- Test world for the Jackal single-field port: 8 x 8 m room with border walls and a
     1.5 x 1.5 m box in the centre. Matches scripts/sim_jackal_2d.py. -->
<sdf version='1.9'>
  <world name='obstacle_room'>
    <physics type='ode'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>333</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Sensors' filename='libgz-sim-sensors-system.so'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='libgz-sim-imu-system.so'/>
    <plugin name='gz::sim::systems::NavSat' filename='libgz-sim-navsat-system.so'/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>43.500720</latitude_deg>
      <longitude_deg>-80.546793</longitude_deg>
      <elevation>329</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light type='directional' name='sun'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name='visual'><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_north'>
      <static>true</static>
      <pose>0 4.05 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>8.2 0.1 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>8.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_south'>
      <static>true</static>
      <pose>0 -4.05 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>8.2 0.1 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>8.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_east'>
      <static>true</static>
      <pose>4.05 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.1 8.0 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_west'>
      <static>true</static>
      <pose>-4.05 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.1 8.0 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name='centre_box'>
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>1.5 1.5 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>1.5 1.5 1.0</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
