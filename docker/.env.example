# Copy to docker/.env and match the values in the robot's /etc/clearpath/robot.yaml
# (ros2 section). The desktop and the robot must agree on all of these.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Only if the robot uses a Fast DDS discovery server (robot.yaml discovery: server):
# ROS_DISCOVERY_SERVER=192.168.1.124:11811
# ROS_SUPER_CLIENT=true

# Only if your host uid/gid is not 1000:
# HOST_UID=1000
# HOST_GID=1000
